<Project>
  <!-- ffmpeg нужен OpenCV только для видеофайлов и потоков; камера работает через DirectShow, сервер видео не открывает. -->
  <Target Name="ExcludeOpenCvFfmpegFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
    </ItemGroup>
  </Target>
</Project>
